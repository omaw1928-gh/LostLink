# ─────────────────────────────────────────────────────────────────────────────
#  LostLink — Docker Compose environment variables
#  Copy this file to .env (same directory) and fill in your real values.
#  NEVER commit the real .env file — it is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster> with your real Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lostlink?retryWrites=true&w=majority

# JWT signing secret — use a long, random string in production
JWT_SECRET=replace_with_a_long_random_secret_string

# Cloudinary credentials (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend origin allowed by CORS
# Leave as the Vercel URL for the production app, or use http://localhost:5173
# when testing locally with the Vite dev server
CLIENT_URL=https://lost-link-ten.vercel.app
