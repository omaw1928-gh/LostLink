# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lostlink?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=lostlink_super_secret_jwt_key_campus_2025_secure_token

# Cloudinary Credentials (Item & Profile Images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173
