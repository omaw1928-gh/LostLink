# ── Node dependencies (rebuilt inside the container via npm ci) ──
node_modules/

# ── Git history (not needed in the image) ──
.git/
.gitignore

# ── Local environment files (secrets must NOT be baked into the image) ──
.env
.env.local
.env.*.local

# ── Logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ── OS / Editor artifacts ──
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ── Development tooling configs (not required at runtime) ──
*.md
